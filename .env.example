# Port du serveur (optionnel, 3000 par défaut)
PORT=3000

# Email de destination des demandes de devis
CONTACT_TO_EMAIL=infosergiosvoix@gmail.com

# Identifiants SMTP pour l'envoi d'email (ex: Gmail avec un mot de passe d'application,
# ou un service comme Brevo / SendGrid / Mailgun)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
